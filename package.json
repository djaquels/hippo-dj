{
  "name": "hippo-dj-frontend",
  "version": "0.1.0",
  "main": "src-electron/main.js",
  "private": true,
  "scripts": {
    "dev:vite": "vite --config vite.config.js",
    "dev:electron": "cross-env NODE_ENV=development wait-on http://localhost:5173 && npx electron .",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "build:renderer": "vite build --config vite.config.js",
    "build": "npm run build:renderer && electron-builder"
  },
  "dependencies": {
    "cross-env": "^10.1.0",
    "jsmidgen": "^0.1.8 ",
    "node-fetch": "^3.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^8.2.0",
    "electron": "^26.0.0",
    "electron-builder": "^24.6.0",
    "vite": "^5.1.0",
    "wait-on": "^7.0.0"
  }
}

{
  "name": "hippo-dj-frontend",
  "version": "0.1.0",
  "main": "src-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "dev-win": "npx vite wait-on http://localhost:5173 && npx electron .",
    "build": "vite build && electron-builder",
    "start": "electron .",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && npx electron ."
  },
  "dependencies": {
    "jsmidgen": "^0.1.8 ",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "electron": "^26.0.0",
    "electron-builder": "^24.6.0",
    "vite": "^5.1.0",
    "@vitejs/plugin-react": "^4.0.0",
    "wait-on": "^7.0.0"
  }
}